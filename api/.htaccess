# Universal Office API -- Apache rules (Spaceship shared hosting / cPanel).
# Every request that is not the front controller is either routed to it or
# refused. Source, migrations, cron and CLI scripts must never be reachable.

# The site root may be under hosting-level password protection (HTTP Basic auth) before launch.
# The API has its own authentication (bearer tokens in the Authorization header -- the same header
# Basic auth uses, so the two cannot coexist), and the future native app cannot answer a password
# prompt. So the API folder is exempt from the site password; the rest of the site stays locked.
AuthType None
Require all granted

# Force HTTPS.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Refuse the private directories outright.
RewriteRule ^(src|lib|migrations|cron|cli|tests|dev)(/|$) - [F,L]

# Refuse any PHP file other than the front controller, and any config file.
RewriteRule ^(?!index\.php$).*\.php$ - [F,L]
RewriteRule (^|/)config[^/]*\.(php|json|ini)$ - [F,L]
RewriteRule (^|/)[^/]*\.(cnf|sql|gz|log)$ - [F,L]

# Serve real files (openapi.yaml, index.php); route everything else to the API.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# Belt and braces: deny config-like files even if the rewrite rules above are
# ever disabled.
<FilesMatch "^(config.*\.php|.*\.cnf|.*\.sql|.*\.gz)$">
  Require all denied
</FilesMatch>
